# Copy this file to ".env" (same folder) and fill in your values.
# Leave GEMINI_API_KEY empty to run in MOCK MODE (no external calls).
GEMINI_API_KEY=

# Any Gemini vision-capable model id works here.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted image size in megabytes.
MAX_UPLOAD_MB=8

# Seconds to wait for the vision API before giving up.
REQUEST_TIMEOUT_S=60